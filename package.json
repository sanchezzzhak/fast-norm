{
  "name": "fast-norm",
  "version": "1.0.2",
  "main": "./fast-norm.js",
  "module": "./fast-norm.mjs",
  "types": "./fast-norm.d.ts",
  "keywords": [
    "napi-rs",
    "onnx-runtime-node",
    "openvino-node",
    "image-to-tensor",
    "image-normalization",
    "tensor-preparation",
    "onnxruntime",
    "planar-preprocessing",
    "yolo11-result",
    "buffer-to-tensor"
  ],
  "exports": {
    ".": {
      "types": "./fast-norm.d.ts",
      "import": "./fast-norm.mjs",
      "require": "./fast-norm.js"
    }
  },
  "napi": {
    "binaryName": "fast-norm",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "install": "node scripts/install-strategy.js",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.1",
    "@napi-rs/wasm-runtime": "^1.1.5",
    "bench-node": "^0.15.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanchezzzhak/fast-norm.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sanchezzzhak/fast-norm/issues"
  },
  "homepage": "https://github.com/sanchezzzhak/fast-norm#readme"
}